generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SYSTEM
  SUPER_ADMIN
  MANUFACTURER
  AUTHORIZED_PERSON
  DIRECTOR
  RETAILER
  DISTRIBUTOR
}

enum UserStatus {
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
}

enum CompanyType {
  LIMITED
  PVT_LTD
  PROPRIETORSHIP
  PARTNERSHIP
}

enum DirectorType {
  DIRECTOR
  PARTNER
  PROPRIETOR
}

enum LicenseCategory {
  SEEDS
  INSECTICIDE
  FERTILIZER
}

enum DistributorType {
  STATE_DISTRIBUTOR
  UNDER_MANUFACTURER
  UNDER_RETAILER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
}

enum ProductType {
  PESTICIDE
  FUNGICIDE
  PGR
  NPK
  FERTILIZER
  BIO_PESTICIDE
  BIO_FUNGICIDE
  BIO_PGR
  BIO_FERTILIZER
}

enum ProductStatus {
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
  DECLINED
  REVERIFY
}

enum DoseUnit {
  PER_ACRE
  PER_HECTARE
}

enum InventoryType {
  WAREHOUSE
  SHOP
  GODOWN
  DISTRIBUTION_CENTER
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
}

enum StockSourceType {
  MANUFACTURER
  OTHER
}

enum StockUnit {
  KG
  G
  L
  ML
  PACK
  BAG
  BOTTLE
  QUANTAL
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  password  String?
  role      Role
  status    UserStatus @default(DRAFT)
  createdBy String?    @db.Uuid
  updatedBy String?    @db.Uuid
  deletedAt DateTime?
  deletedBy String?    @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  createdByUser User? @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("UserDeletedBy", fields: [deletedBy], references: [id])

  usersCreated User[] @relation("UserCreatedBy")
  usersUpdated User[] @relation("UserUpdatedBy")
  usersDeleted User[] @relation("UserDeletedBy")

  phones             Phone[]
  emails             Email[]
  refreshTokens      RefreshToken[]
  manufacturer       Manufacturer?
  retailer           Retailer?
  distributor        Distributor?
  authorizedPersons  AuthorizedPerson[]
  directors          Director[]
  auditLogs          AuditLog[]
  statusChanges      StatusHistory[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// ─── Phone ───────────────────────────────────────────────────────────────────

model Phone {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  number    String   @unique @db.VarChar(15)
  isPrimary Boolean  @default(false)
  label     String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phones")
}

// ─── Email ───────────────────────────────────────────────────────────────────

model Email {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  address   String   @unique @db.VarChar(255)
  isPrimary Boolean  @default(false)
  label     String?  @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("emails")
}

// ─── RefreshToken ────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Manufacturer ────────────────────────────────────────────────────────────

model Manufacturer {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @unique @db.Uuid
  companyName        String
  companyType        CompanyType
  licenseNumber      String?
  licenseValidUpto   DateTime?
  gstNumber          String?
  udyogAadhaar       String?
  companyPan         String?
  canAddEditProducts Boolean     @default(false)
  canManageBatch     Boolean     @default(false)
  isDraft            Boolean     @default(false)
  createdBy          String?     @db.Uuid
  updatedBy          String?     @db.Uuid
  deletedAt          DateTime?
  deletedBy          String?     @db.Uuid
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses         Address[]
  bankDetails       BankDetails[]
  directors         Director[]
  authorizedPersons AuthorizedPerson[]
  documents         Document[]
  distributors      Distributor[]
  products          Product[]          @relation("ProductManufacturer")
  manufacturedProducts Product[]       @relation("ProductManufacturedBy")
  marketedProducts  Product[]          @relation("ProductMarketedBy")
  inventories       Inventory[]

  @@index([userId])
  @@index([deletedAt])
  @@map("manufacturers")
}

// ─── Retailer ────────────────────────────────────────────────────────────────

model Retailer {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @unique @db.Uuid
  companyName    String
  companyType    CompanyType
  gstNumber      String?
  companyPan     String?
  isDraft        Boolean     @default(false)
  createdBy      String?     @db.Uuid
  updatedBy      String?     @db.Uuid
  deletedAt      DateTime?
  deletedBy      String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses         Address[]
  bankDetails       BankDetails[]
  licenses          RetailerLicense[]
  directors         Director[]
  authorizedPersons AuthorizedPerson[]
  documents         Document[]
  distributors      Distributor[]
  inventories       Inventory[]

  @@index([userId])
  @@index([deletedAt])
  @@map("retailers")
}

// ─── RetailerLicense ────────────────────────────────────────────────────────

model RetailerLicense {
  id            String          @id @default(uuid()) @db.Uuid
  retailerId    String          @db.Uuid
  category      LicenseCategory
  licenseNumber String?
  validUptoDate DateTime?
  createdBy     String?         @db.Uuid
  updatedBy     String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  retailer  Retailer   @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([retailerId, category])
  @@index([retailerId])
  @@map("retailer_licenses")
}

// ─── Distributor ─────────────────────────────────────────────────────────────

model Distributor {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @unique @db.Uuid
  distributorType  DistributorType
  gstNumber        String?
  licenseNumber    String?
  licenseValidUpto DateTime?
  manufacturerId   String?         @db.Uuid
  retailerId       String?         @db.Uuid
  companyName      String?
  companyType      CompanyType?
  companyPan       String?
  isDraft          Boolean         @default(false)
  createdBy        String?         @db.Uuid
  updatedBy        String?         @db.Uuid
  deletedAt        DateTime?
  deletedBy        String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  manufacturer      Manufacturer?      @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  retailer          Retailer?          @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  addresses         Address[]
  bankDetails       BankDetails[]
  licenses          DistributorLicense[]
  directors         Director[]
  authorizedPersons AuthorizedPerson[]
  documents         Document[]
  inventories       Inventory[]

  @@index([userId])
  @@index([deletedAt])
  @@index([manufacturerId])
  @@index([retailerId])
  @@map("distributors")
}

// ─── DistributorLicense ─────────────────────────────────────────────────────

model DistributorLicense {
  id            String          @id @default(uuid()) @db.Uuid
  distributorId String          @db.Uuid
  category      LicenseCategory
  licenseNumber String?
  validUptoDate DateTime?
  createdBy     String?         @db.Uuid
  updatedBy     String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  documents   Document[]

  @@unique([distributorId, category])
  @@index([distributorId])
  @@map("distributor_licenses")
}

// ─── Address ─────────────────────────────────────────────────────────────────

model Address {
  id             String   @id @default(uuid()) @db.Uuid
  entityType     String   @db.VarChar(50)
  entityId       String?  @db.Uuid
  retailerId     String?  @db.Uuid
  distributorId  String?  @db.Uuid
  address1       String
  address2       String?
  city           String
  state          String
  pincode        String   @db.VarChar(6)
  createdBy      String?  @db.Uuid
  updatedBy      String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  retailer     Retailer?     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  distributor Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([retailerId])
  @@index([distributorId])
  @@map("addresses")
}

// ─── BankDetails ─────────────────────────────────────────────────────────────

model BankDetails {
  id             String   @id @default(uuid()) @db.Uuid
  entityType     String   @db.VarChar(50)
  entityId       String?  @db.Uuid
  retailerId     String?  @db.Uuid
  distributorId  String?  @db.Uuid
  accountName    String
  accountNumber  String
  ifscCode       String   @db.VarChar(11)
  bankName       String
  createdBy      String?  @db.Uuid
  updatedBy      String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  manufacturer Manufacturer? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  retailer     Retailer?     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  distributor  Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@index([entityType, entityId])
  @@index([retailerId])
  @@index([distributorId])
  @@map("bank_details")
}

// ─── Director ────────────────────────────────────────────────────────────────

model Director {
  id             String       @id @default(uuid()) @db.Uuid
  manufacturerId String?      @db.Uuid
  retailerId     String?      @db.Uuid
  distributorId  String?      @db.Uuid
  userId         String       @db.Uuid
  type           DirectorType
  designation    String?      @db.VarChar(255)
  aadhaarNumber  String?      @db.VarChar(12)
  panNumber      String?      @db.VarChar(10)
  createdBy      String?      @db.Uuid
  updatedBy      String?      @db.Uuid
  deletedAt      DateTime?
  deletedBy      String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  retailer     Retailer?     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  distributor Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([manufacturerId, userId])
  @@unique([retailerId, userId])
  @@unique([distributorId, userId])
  @@index([manufacturerId])
  @@index([retailerId])
  @@index([distributorId])
  @@index([userId])
  @@index([deletedAt])
  @@map("directors")
}

// ─── AuthorizedPerson ────────────────────────────────────────────────────────

model AuthorizedPerson {
  id             String    @id @default(uuid()) @db.Uuid
  manufacturerId String?   @db.Uuid
  retailerId     String?   @db.Uuid
  distributorId  String?   @db.Uuid
  userId         String    @db.Uuid
  aadhaarNumber  String?   @db.VarChar(12)
  createdBy      String?   @db.Uuid
  updatedBy      String?   @db.Uuid
  deletedAt      DateTime?
  deletedBy      String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  retailer     Retailer?     @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  distributor  Distributor?  @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@unique([manufacturerId, userId])
  @@unique([retailerId, userId])
  @@unique([distributorId, userId])
  @@index([manufacturerId])
  @@index([retailerId])
  @@index([distributorId])
  @@index([userId])
  @@index([deletedAt])
  @@map("authorized_persons")
}

// ─── Document ────────────────────────────────────────────────────────────────

model Document {
  id               String    @id @default(uuid()) @db.Uuid
  entityType       String    @db.VarChar(50)
  entityId         String    @db.Uuid
  docType          String    @db.VarChar(50)
  fileName         String
  filePath         String
  mimeType         String
  fileSize         Int
  uploadedBy       String?   @db.Uuid
  deletedAt        DateTime?
  deletedBy        String?   @db.Uuid
  createdAt        DateTime  @default(now())

  // Polymorphic: entityType discriminates which parent owns this doc.
  manufacturerId       String?   @db.Uuid
  directorId           String?   @db.Uuid
  authorizedPersonId   String?   @db.Uuid
  bankDetailsId        String?   @db.Uuid
  retailerId           String?   @db.Uuid
  retailerLicenseId    String?   @db.Uuid
  distributorId        String?   @db.Uuid
  distributorLicenseId String?   @db.Uuid
  productId            String?   @db.Uuid
  productSizeId        String?   @db.Uuid

  manufacturer      Manufacturer?     @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  director          Director?         @relation(fields: [directorId], references: [id], onDelete: Cascade)
  authorizedPerson  AuthorizedPerson? @relation(fields: [authorizedPersonId], references: [id], onDelete: Cascade)
  bankDetails       BankDetails?      @relation(fields: [bankDetailsId], references: [id], onDelete: Cascade)
  retailer          Retailer?         @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  retailerLicense   RetailerLicense?  @relation(fields: [retailerLicenseId], references: [id], onDelete: Cascade)
  distributor       Distributor?      @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  distributorLicense DistributorLicense? @relation(fields: [distributorLicenseId], references: [id], onDelete: Cascade)
  product            Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productSize        ProductSize?     @relation(fields: [productSizeId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("documents")
}

// ─── AuditLog ────────────────────────────────────────────────────────────────

model AuditLog {
  id              String      @id @default(uuid()) @db.Uuid
  action          AuditAction
  entityType      String      @db.VarChar(50)
  entityId        String      @db.Uuid
  performedBy     String      @db.Uuid
  performedByRole String      @db.VarChar(20)
  previousData    Json?
  newData         Json?
  ipAddress       String?     @db.VarChar(45)
  userAgent       String?
  createdAt       DateTime    @default(now())

  performer User @relation(fields: [performedBy], references: [id])

  @@index([entityType, entityId])
  @@index([performedBy])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── StatusHistory ───────────────────────────────────────────────────────────

model StatusHistory {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String   @db.VarChar(50)
  entityId      String   @db.Uuid
  fromStatus    String?  @db.VarChar(20)
  toStatus      String   @db.VarChar(20)
  reason        String?
  changedBy     String   @db.Uuid
  changedByRole String   @db.VarChar(20)
  createdAt     DateTime @default(now())

  changer User @relation(fields: [changedBy], references: [id])

  @@index([entityType, entityId])
  @@index([changedBy])
  @@map("status_histories")
}

// ─── Product ─────────────────────────────────────────────────────────────────

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  manufacturerId    String        @db.Uuid
  productType       ProductType
  productName       String
  technicalName     String
  manufacturedById  String        @db.Uuid
  marketedById      String?       @db.Uuid
  description       String        @db.Text
  cirNumber         String?
  gstPercentage     Decimal       @db.Decimal(5, 2)
  hsnCode           String
  recommendedDose   String
  doseUnit          DoseUnit
  status            ProductStatus @default(DRAFT)
  isDraft           Boolean       @default(false)
  createdBy         String?       @db.Uuid
  updatedBy         String?       @db.Uuid
  deletedAt         DateTime?
  deletedBy         String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  manufacturer      Manufacturer  @relation("ProductManufacturer", fields: [manufacturerId], references: [id])
  manufacturedBy    Manufacturer  @relation("ProductManufacturedBy", fields: [manufacturedById], references: [id])
  marketedBy        Manufacturer? @relation("ProductMarketedBy", fields: [marketedById], references: [id])
  sizes             ProductSize[]
  crops             ProductCrop[]
  documents         Document[]
  inventoryProducts InventoryProduct[]

  @@index([manufacturerId])
  @@index([productType])
  @@index([status])
  @@index([deletedAt])
  @@index([hsnCode])
  @@map("products")
}

// ─── ProductSize ─────────────────────────────────────────────────────────────

model ProductSize {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @db.Uuid
  quantity       String
  unit           String
  bottlesPerCase Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([productId])
  @@map("product_sizes")
}

// ─── ProductCrop ─────────────────────────────────────────────────────────────

model ProductCrop {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  cropName  String
  isCustom  Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, cropName])
  @@index([productId])
  @@map("product_crops")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Inventory {
  id             String          @id @default(uuid()) @db.Uuid
  ownerType      String          @db.VarChar(50)
  manufacturerId String?         @db.Uuid
  retailerId     String?         @db.Uuid
  distributorId  String?         @db.Uuid
  name           String
  type           InventoryType
  description    String?         @db.Text
  status         InventoryStatus @default(ACTIVE)
  address1       String
  address2       String?
  city           String
  state          String
  pincode        String          @db.VarChar(6)
  contactName    String?
  contactPhone   String?         @db.VarChar(15)
  contactEmail   String?         @db.VarChar(255)
  createdBy      String?         @db.Uuid
  updatedBy      String?         @db.Uuid
  deletedAt      DateTime?
  deletedBy      String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  manufacturer Manufacturer?   @relation(fields: [manufacturerId], references: [id])
  retailer     Retailer?       @relation(fields: [retailerId], references: [id])
  distributor  Distributor?    @relation(fields: [distributorId], references: [id])
  products     InventoryProduct[]

  @@index([ownerType])
  @@index([manufacturerId])
  @@index([retailerId])
  @@index([distributorId])
  @@index([status])
  @@index([deletedAt])
  @@map("inventories")
}

// ─── InventoryProduct ───────────────────────────────────────────────────────

model InventoryProduct {
  id               String          @id @default(uuid()) @db.Uuid
  inventoryId      String          @db.Uuid
  productId        String          @db.Uuid
  productSizeId    String?         @db.Uuid
  stock            Int             @default(0)
  price            Decimal         @db.Decimal(12, 2)
  averageCost      Decimal?        @db.Decimal(12, 2)
  sourceType       StockSourceType
  batchNumber      String?
  mfgDate          DateTime?
  expiryDate       DateTime?
  purchasedFrom    String?
  unit             StockUnit
  lowStockThreshold Int            @default(10)
  createdBy        String?         @db.Uuid
  updatedBy        String?         @db.Uuid
  deletedAt        DateTime?
  deletedBy        String?         @db.Uuid
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@index([inventoryId])
  @@index([productId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([deletedAt])
  @@map("inventory_products")
}
